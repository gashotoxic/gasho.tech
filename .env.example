# gasho.tech — environment variables
#
# Copy to `.env.local` for local development (`cp .env.example .env.local`);
# on Vercel set the same names under Project → Settings → Environment Variables.
# Nothing in this file is a real credential.

# --- Chat proxy (`app/api/chat/route.ts`) ------------------------------------
# Bearer token for the upstream LLM (https://chutes.ai/api/v1/chat/completions).
# The endpoint FAILS CLOSED: with this unset (or whitespace only) every request
# answers 503 and no upstream call is made. There is no fallback credential.
GT_ASSIST_API_KEY=
# Optional. Comma-separated extra origins allowed to call the chat proxy from a
# browser. gasho.tech / www.gasho.tech / gashotech.com / www.gashotech.com and the
# current deployment host are allowed already; this is only for staging hosts.
GT_ASSIST_ALLOWED_ORIGINS=

# --- Blog publishing (`lib/github.ts`, `github.ts`) -------------------------
# GitHub PAT with `contents: read/write` on the repo that stores data/blogs.json.
# Writes fail (503) without it; reads fall back to the deployed snapshot.
GH_TOKEN=

# --- Blog admin session (`lib/auth.ts`) -------------------------------------
# Password for the blog admin login and the HMAC secret used to sign the session
# cookie. Both are required; the admin endpoints fail closed without them.
BLOG_ADMIN_PASSWORD=
BLOG_SESSION_SECRET=

# --- Studio (`lib/studio-api.ts`, `app/api/studio/*`) -----------------------
# Paid provider key for the studio generate/write/image routes.
CHUTES_API_KEY=

# --- Contact form mail (`lib/email.ts`) -------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL=gashotechnologies@gmail.com

# --- Site metadata ----------------------------------------------------------
# Canonical origin used for robots/sitemap/OG URLs. Defaults to
# https://gashotech.com when unset.
NEXT_PUBLIC_SITE_URL=https://gashotech.com
